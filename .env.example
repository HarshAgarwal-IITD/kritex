# VITE_* values are compiled into the public JS bundle: anyone can read them. Only public URLs and
# flags go here, never keys or secrets. Changing one on Vercel needs a redeploy (they are baked in at build).

# Base URL of kritex-server (no trailing slash).
# Leave unset in local dev: requests go to the same origin and Vite proxies /api -> http://localhost:4000.
# Production (Vercel): https://api.kritex.in, not the *.onrender.com URL: the session/cart cookies only
# work when the API is on a kritex.in subdomain, and calling it directly gives the API real client IPs (RL-1).
# VITE_API_URL="https://api.kritex.in"

# Dev only: "true" starts the MSW mock service worker (src/mocks) so the UI works without the backend.
VITE_USE_MOCKS="false"

# Used by `npm run api:gen` (not by Vite): path or URL of the backend OpenAPI spec.
# Defaults to ../kritex-server/openapi.json. Can also be a URL like http://localhost:4000/api/docs-json
# API_SPEC="../kritex-server/openapi.json"

# Object store origin for images (e.g. https://assets.kritex.in). Leave unset to serve from /public.
# VITE_ASSET_BASE_URL=""
# Public origin of the storefront (no trailing slash). Used for canonical URLs and Open Graph tags.
# Defaults to https://kritex.in when unset; set it for preview/staging deploys.
# VITE_SITE_URL="https://kritex.in"
