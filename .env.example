# Base URL of kritex-server (no trailing slash).
# Leave unset in local dev: requests go to the same origin and Vite proxies /api -> http://localhost:4000.
# Only needed for production/preview builds, e.g. VITE_API_URL="https://api.kritex.in"
# VITE_API_URL=""

# Dev only: "true" starts the MSW mock service worker (src/mocks) so the UI works without the backend.
VITE_USE_MOCKS="false"

# Used by `npm run api:gen` (not by Vite): path or URL of the backend OpenAPI spec.
# Defaults to ../kritex-server/openapi.json. Can also be a URL like http://localhost:4000/api/docs-json
# API_SPEC="../kritex-server/openapi.json"
